# stage.py copies only the selected current sources/headers into build output.
# The root-loader files retain their canonical repository source identities.
obj-m += maplesu_ultra_bridge.o
maplesu_ultra_bridge-y := bridge.o boot_events.o preinit.o preinit_blob.o native_layout.o native_lookup.o native_legacy_cfi.o native_imports.o \
    native_sdk_imports.o producer/module/maplesu_boot_sdk.o producer/module/boot_sdk_call.o \
    host/install_records.o host/protected_install_kernel.o host/manager_apk_identity.o \
    host/manager_claim_entry.o host/manager_owner.o host/manager_owner_watch.o \
    host/manager_resident_host.o host/manager_management.o host/manager_uid_gateway.o \
    host/manager_uid_snapshot.o host/su_install_registry.o host/su_profile_apply.o \
    host/su_profile_namespace.o host/su_profile_execution.o host/su_profile_resolve.o

ccflags-y += -I$(src) -I$(src)/host -I$(src)/producer -I$(src)/producer/module
ccflags-y += -include $(src)/native_direct.h
# Do not disable target CFI, LTO, SCS, stack protection, module CRCs or namespaces.
ccflags-y += -DMSU_BOOT_SDK_NATIVE=1
asflags-y += -I$(src) -DMSU_BOOT_SDK_NATIVE=1
# Assembly shares the C sanitizer mode without inheriting C-only options.
msu_bridge_cc_has_kcfi := $(shell output="$$($(CC) $(NOSTDINC_FLAGS) $(LINUXINCLUDE) \
    $(KBUILD_CPPFLAGS) $(KBUILD_CFLAGS) $(KBUILD_CFLAGS_MODULE) $(ccflags-y) \
    -E -dM -x c $(src)/native_cfi.h)" || { status=$$?; printf '%s\n' "$$output" >&2; exit $$status; }; \
    printf '%s\n' "$$output" | awk '$$2 == "MSU_INIT_BRIDGE_CC_HAS_KCFI" { print $$3 }')
ifeq ($(filter 0 1,$(msu_bridge_cc_has_kcfi)),)
$(error Ultra init bridge CFI compiler feature probe failed)
endif
asflags-y += -DMSU_INIT_BRIDGE_CC_HAS_KCFI=$(msu_bridge_cc_has_kcfi)

host_tus := protected_install_kernel manager_claim_entry manager_resident_host manager_management manager_owner_watch manager_task_state manager_uid_gateway su_install_registry su_profile_namespace
# Runtime objects come from the owner's frozen native emission, not live roots.
include $(src)/selected-runtime.mk
$(foreach tu,$(host_tus),$(eval CFLAGS_host/$(tu).o += -DMSU_INIT_BRIDGE_HOST_IMPORTS=1 -include $(src)/native_imports.h))
CFLAGS_boot_events.o += -DMSU_INIT_BRIDGE_HOST_IMPORTS=1 -include $(src)/native_imports.h

# stage.py retains exact task-state/credential-domain dependency identities.
# Runtime source selection does not qualify target entrypoints or publication.
include $(src)/selected-core.mk

# Same static nolibc/UAPI build model and 64 KiB ELF mapping as pinned KSU.
MSU_PREINIT_UAPI := $(objtree)/usr/include
ifeq ($(wildcard $(MSU_PREINIT_UAPI)/linux/unistd.h),)
$(error MapleSU preinit runner requires target installed UAPI headers)
endif
MSU_PREINIT_CFLAGS := $(CLANG_FLAGS) -std=gnu11 -Os -Wall -Werror \
    -nostdinc -isystem $(shell $(CC) -print-file-name=include) \
    -I$(src)/preinit/nolibc -I$(MSU_PREINIT_UAPI) \
    -ffreestanding -fno-stack-protector -fno-pic -fno-pie \
    -fno-asynchronous-unwind-tables -fno-unwind-tables -ffunction-sections -fdata-sections
quiet_cmd_msu_preinit = PREINIT $@
      cmd_msu_preinit = $(CC) $(MSU_PREINIT_CFLAGS) -c -o $@.o $< && \
    $(LD) -static -nostdlib -e _start --gc-sections -s -z max-page-size=0x10000 \
    -z noseparate-code -o $@ $@.o && rm -f $@.o
$(obj)/preinit/runner.elf: $(src)/preinit/runner.c \
    $(wildcard $(src)/preinit/nolibc/*.h $(src)/preinit/nolibc/sys/*.h) FORCE
	$(call if_changed,msu_preinit)
targets += preinit/runner.elf
$(obj)/preinit_blob.o: $(obj)/preinit/runner.elf
asflags-y += -DMSU_PREINIT_RUNNER_BIN=\"$(obj)/preinit/runner.elf\"
